# --- Model providers (need at least the one matching MODEL_PROVIDER below) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which provider the model factory uses. "openai" (default) or "anthropic".
MODEL_PROVIDER=openai
# Optional: override the default model id for the chosen provider.
# MODEL_NAME=gpt-4o-mini

# --- LangSmith tracing (optional in Phase 1; required for Phase 3 evals) ---
# Leave LANGSMITH_TRACING unset/false to run without tracing.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=redcell
